# Copy to .env.local and fill in values.
# Never commit real secrets.

# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority

# Auth (generate long random strings, e.g. openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# First admin (used by npm run seed)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe!23456
ADMIN_NAME=Site Owner

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=business-site

# Email via Resend (optional in local — emails log to console if unset)
RESEND_API_KEY=
EMAIL_FROM="Harbor & Hearth <onboarding@resend.dev>"

# Optional bot protection (leave empty to skip; honeypot still active)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Or Google reCAPTCHA instead of Turnstile:
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
